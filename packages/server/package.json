{
  "name": "@kvy/server",
  "version": "0.1.0",
  "private": true,
  "description": "kvy-server — Fastify 5 API. Blind to user content: routes ciphertext and coordination metadata only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -e \"import('./src/db/migrate.ts').then(m => m.runMigrations())\""
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.2.0",
    "@kvy/crypto": "workspace:*",
    "@kvy/wire": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.8",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "pkgroll": "^2.14.2",
    "shx": "^0.4.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.10",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
