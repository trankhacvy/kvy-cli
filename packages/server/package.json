{
  "name": "@falcon/server",
  "version": "0.1.0",
  "private": true,
  "description": "falcon-server — Fastify 5 API. Blind to user content: routes ciphertext and coordination metadata only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -e \"import('./src/db/migrate.ts').then(m => m.runMigrations())\""
  },
  "dependencies": {
    "@falcon/crypto": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "tweetnacl": "^1.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "pkgroll": "^2.14.2",
    "shx": "^0.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
