{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/dashboard/session/unmanaged/:id/",
      "destination": "/dashboard/session/unmanaged/demo/"
    },
    {
      "source": "/dashboard/session/:id/checks/",
      "destination": "/dashboard/session/demo/checks/"
    },
    {
      "source": "/dashboard/session/:id/files/",
      "destination": "/dashboard/session/demo/files/"
    },
    {
      "source": "/dashboard/session/:id/preview/",
      "destination": "/dashboard/session/demo/preview/"
    },
    {
      "source": "/dashboard/session/:id/run/",
      "destination": "/dashboard/session/demo/run/"
    },
    {
      "source": "/dashboard/session/:id/git/",
      "destination": "/dashboard/session/demo/git/"
    },
    {
      "source": "/dashboard/session/:id/",
      "destination": "/dashboard/session/demo/"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/crypto-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/precache-manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
