# Base URL of the Falcon API server (Fastify). Defaults to http://localhost:3005.
# NEXT_PUBLIC_API_URL=http://localhost:3005

# Public web origin (canonical URLs, Open Graph). Defaults to https://app.falcon.dev.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth sign-in providers (unset hides that provider's button on /signin).
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=

# Dev-auth bypass button on /signin — only works against a server that also
# has FALCON_DEV_AUTH=1 set (packages/server). Local testing only.
# NEXT_PUBLIC_FALCON_DEV_AUTH=1

# Web Push VAPID public key — unset disables the notifications subscribe button.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PTY-path real setMode (Shift+Tab cycle) — only enable against a CLI stack
# that also has FALCON_PTY_SETMODE=1 set.
# NEXT_PUBLIC_FALCON_PTY_SETMODE=1
