{
  "name": "@falcon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "falcon-web — Next.js PWA (App Router, static export). Statically exported and served from a separate origin than the API (design §5.3, §9): the server never renders user content, it's ciphertext to it anyway. Crypto worker bridge, the transcript reducer, apiSocket (the user-scoped WS client), and the sync engine (headerSeq/msgSeq fast-path, src/sync/) are wired up; auth pages are still planned.",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@falcon/crypto": "workspace:*",
    "@falcon/wire": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "nanoid": "^6.0.0",
    "next": "^15.5.20",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-react": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.13.1",
    "shiki": "^4.3.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
