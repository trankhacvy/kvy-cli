{
  "name": "@falcon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "falcon-web — Next.js PWA (App Router, static export). Statically exported and served from a separate origin than the API (design §5.3, §9): the server never renders user content, it's ciphertext to it anyway. Scaffold stage — no auth/sync/API wiring yet.",
