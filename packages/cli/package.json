{
  "name": "falcon",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "falcon — CLI wrapper for Claude Code / Codex agent sessions. Hand-rolled arg parsing (no framework, matching Happy's approach), full flag passthrough to the underlying provider CLI, file-only logging (stdout/stderr are reserved for the real provider TUI once local-mode spawning lands).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falcon-dev/falcon.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/falcon-dev/falcon#readme",
  "bugs": "https://github.com/falcon-dev/falcon/issues",
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "agent",
    "ai"
  ],
  "bin": {
    "falcon": "./bin/falcon.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:provider": "tsx scripts/provider-contract-test.ts",
    "contract:acp": "tsx scripts/acp-contract-test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@falcon/crypto": "workspace:*",
    "@falcon/wire": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ink": "^7.1.0",
    "node-pty": "^1.1.0",
    "open": "^10.2.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@falcon/server": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.0",
    "pkgroll": "^2.14.2",
    "shx": "^0.3.4",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
