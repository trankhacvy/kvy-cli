{
  "name": "@kvy/wire",
  "version": "0.1.0",
  "description": "Wire-protocol contracts shared by every Kvy package. Additive-only forever — see src/index.ts.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:additive": "tsx scripts/check-additive-vs-base.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "shx": "^0.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
