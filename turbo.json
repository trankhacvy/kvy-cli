{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "globalPassThroughEnv": ["SKIP_FALCON_WIRE_BUILD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@falcon/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    // @falcon/e2e is a scripted harness (design §13 item 3), not a library —
    // its "build" is a type-check only (`tsc --noEmit`, no pkgroll bundle;
    // it's driven via `tsx`/vitest in-repo, never published or imported by
    // another package). No `dist/**` to cache.
    "@falcon/e2e#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@falcon/web#typecheck": {
      // Unlike the default `typecheck` task (which only needs upstream
      // workspace packages built, via `^build`), @falcon/web's `tsc --noEmit`
      // type-checks generated route types under `.next/types/app/**` that
      // Next.js only emits as a side effect of `next build`. Depending on
      // just `^build` lets turbo schedule this package's `typecheck` and
      // `build` tasks concurrently, so `tsc` can race a `next build` that
      // hasn't written `.next/types/app/layout.ts` yet, intermittently
      // failing with TS6053 ('File ... not found') when both tasks are run
      // together in one `turbo run build typecheck` invocation. Depending on
      // same-package `build` too (in addition to `^build`) forces `next
      // build` to finish first, matching the CLAUDE.md-documented sequential
      // `pnpm build` then `pnpm typecheck` flow that doesn't hit this race.
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@falcon/web#test": {
      // The default `test` task depends on the *same-package* `build` task,
      // which for @falcon/web means a full `next build` static export runs
      // as a prerequisite of `vitest run` on every `pnpm test`. The web
      // package's unit tests (src/lib/utils.test.ts, button.test.ts) import
      // source modules directly — they exercise none of Next's build output
      // — so that dependency is unnecessary. Beyond being wasted work, it's
      // the root cause of intermittent `next build` failures ('<Html> should
      // not be imported outside of pages/_document', 'Cannot find module
      // ./NNN.js') seen under `pnpm test` at the repo root: `next build`
      // competes for CPU/IO with other packages' concurrently-scheduled
      // vitest tasks in Turborepo's parallel scheduler. Depending on `^build`
      // (upstream workspace packages, same as `typecheck`) instead of `build`
      // drops `next build` out of the `test` task graph entirely, so it no
      // longer runs concurrently with sibling packages' tests.
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
