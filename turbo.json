{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "globalPassThroughEnv": ["SKIP_FALCON_WIRE_BUILD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
