# nginx site config for the @falcon/web static export (design §5.3/§9,
# plan.md §16 "4.3 Distribution & self-host": served from an origin separate
# from the API, strict CSP + SRI).
#
# `${API_ORIGIN}`/`${API_ORIGIN_WS}` are substituted at container start by
# the official nginx image's `docker-entrypoint.d/20-envsubst-on-templates.sh`
# (this file lives at /etc/nginx/templates/default.conf.template — see
# web.Dockerfile) against the container's environment; `API_ORIGIN_WS` is
# derived from `API_ORIGIN` by `docker-entrypoint.sh` in this same directory
# before nginx's own entrypoint scripts run. Every other `${...}`-shaped
# token in this file is deliberately written *without* braces (`$uri`,
# `$host`, ...) so nginx's own runtime variables are untouched by envsubst,
# which only rewrites the brace form.
server {
    listen 80;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Strict CSP (plan.md §16 "4.3 ... strict CSP+SRI"). `connect-src` is
    # scoped to this origin plus the configured API origin (REST) and its
    # WebSocket counterpart (Socket.IO, `/v1/stream`) — nothing else is a
    # valid fetch/XHR/WS target for this app. `script-src`/`style-src` need
    # `'unsafe-inline'`: this is a purely static export with no per-request
    # server able to mint a CSP nonce, and Next's App Router embeds its
    # RSC/hydration payload as inline `<script>` even in static builds. That
    # is compensated by Subresource Integrity: every *external* script/style
    # tag Next emits carries a build-time `integrity` hash (next.config.ts's
    # `experimental.sri`), so a tampered/substituted bundle from a
    # compromised static host or CDN in front of this origin still fails to
    # execute even though inline same-origin script is allowed to run.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${API_ORIGIN_WS}; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;

    # `/_next/static/*` filenames are content-hashed by Next — safe to cache
    # forever; a new build always ships new filenames.
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The service worker file itself must never be cached, or clients can get
    # stuck on a stale `sw.js` that never picks up a new deploy.
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
}
