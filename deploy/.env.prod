# Production environment for Kvy server + Postgres.
# Web (@kvy/web) deploys separately to Vercel.
# Blobs use Cloudflare R2 (S3-compatible, cheap).
#
# Copy to .env (or keep as .env.prod if managing multiple environments):
#   cp .env.prod .env
#   docker compose -f docker-compose.prod.yml up -d --build

# ============================================================================
# REQUIRED
# ============================================================================

# HMAC signing key for auth JWTs — anyone with this can mint tokens for any account.
# Generate with: openssl rand -base64 32
KVY_MASTER_SECRET=

# Public origins (your domain + reverse-proxy/CDN, as seen from the outside world).
# MUST match your actual deployment DNS and the Vercel app domain.
PUBLIC_WEB_ORIGIN=https://app.yourcompany.com      # Vercel web app domain
PUBLIC_API_ORIGIN=https://api.yourcompany.com      # This server's public DNS

# ============================================================================
# DATABASE (Postgres 16 — provisioned separately, not bundled in this compose
# file: a Coolify-managed database resource, Neon, RDS, or self-run)
# ============================================================================

# REQUIRED.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ============================================================================
# CLOUDFLARE R2 (S3-compatible blob storage — cheap)
# ============================================================================
# Setup: https://developers.cloudflare.com/r2/api/s3/
#
# 1. Create an R2 bucket in Cloudflare dashboard
# 2. Generate an R2 API token (with read+write permissions)
# 3. Get your account ID from the dashboard

S3_BUCKET=kvy-blobs
S3_REGION=auto
# R2 API endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================================
# OAUTH (Optional — sign-in providers)
# ============================================================================
# If unset, those sign-in buttons won't render (fail closed, not broken).
# Client ID is safe in the public web bundle; client secret is server-side only.

# Google OIDC (implicit flow, client ID is public)
GOOGLE_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID= (set via Vercel env vars, same value)

# GitHub OAuth App (authorization-code flow, requires client secret)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID= (set via Vercel env vars, same value)

# ============================================================================
# WEB PUSH NOTIFICATIONS (Optional)
# ============================================================================
# Generate with: pnpm --filter @kvy/server exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is safe in the web bundle; private key is server-side only.

# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY= (set via Vercel env vars, same value)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourcompany.com

# ============================================================================
# FALLBACK NOTIFICATION CHANNELS (Optional)
# ============================================================================

# Telegram Bot (pairing links, notifications)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# ntfy.sh (push notifications — defaults to https://ntfy.sh)
# NTFY_BASE_URL=https://ntfy.sh

# ============================================================================
# PORTS (Docker internal, mapped via reverse-proxy in production)
# ============================================================================

SERVER_PORT=3005
