# Self-host config for deploy/docker-compose.yml. Copy this to `.env` in this
# same directory (`deploy/.env`) and fill in the values marked REQUIRED.
#
#   cp .env.example .env
#
# Everything else mirrors packages/server/src/config.ts's env schema
# one-to-one — see that file for the full rationale behind each default.

# REQUIRED. HMAC signing key for auth JWTs — anyone holding this can mint
# tokens for any account. Generate one with:
#   openssl rand -base64 32
KVY_MASTER_SECRET=

# Public origins of the two containers, as reachable from a browser/CLI
# outside the Docker network (i.e. the host's real hostname/IP + the
# published port below, or a reverse-proxy hostname if you put one in
# front of this stack). These MUST match the `ports:` mappings below and
# each other — the web origin drives the server's CORS allowlist, and the
# API origin gets baked into the web static bundle at build time.
PUBLIC_WEB_ORIGIN=http://localhost:8080
PUBLIC_API_ORIGIN=http://localhost:3005

# Host-side port mappings (change if 3005/8080 are already taken locally).
SERVER_PORT=3005
WEB_PORT=8080

# --- Blob storage (optional) ---------------------------------------------
# Unset S3_BUCKET (the default) => local-disk blob driver, stored in the
# `kvy-server-data` volume. Set it to opt into S3-compatible storage —
# either a real bucket (AWS S3/R2) or the bundled MinIO service (start it
# with `docker compose --profile minio up -d`).
#
# For the bundled MinIO: S3_ENDPOINT must be the address a browser/CLI
# *outside* the Docker network can reach — not the internal `minio`
# hostname. With the default port mapping that's:
#   S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true is required for MinIO (it doesn't do
# virtual-hosted-style bucket URLs).
# S3_BUCKET=kvy-blobs
# S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=kvy
# S3_SECRET_ACCESS_KEY=kvy12345
# S3_FORCE_PATH_STYLE=true

# Bundled MinIO container's own admin credentials (only read when you run
# with `--profile minio`; unrelated to S3_ACCESS_KEY_ID above, though for
# the bundled MinIO they're typically set to the same values).
# MINIO_ROOT_USER=kvy
# MINIO_ROOT_PASSWORD=kvy12345
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- Optional sign-in / notification channels -----------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# NTFY_BASE_URL=https://ntfy.sh
