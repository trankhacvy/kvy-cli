{
  "name": "falcon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.cjs",
    "build": "turbo run build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . || (echo '[lint] first attempt failed (possibly transient OOM from biome/next resource contention) — retrying once...' >&2 && biome check .)",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@biomejs/biome": "^2.5.4",
    "dotenv": "^17.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  }
}
